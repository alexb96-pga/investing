import pandas as pd
import yfinance as yf
import numpy as np
import requests
from io import StringIO
from fredapi import Fred
from sklearn.linear_model import LinearRegression

# -----------------------------
# Parameters
# -----------------------------
start = "2000-01-01"
end = "2025-12-01"

# -----------------------------
# Download S&P 500 data
# -----------------------------
sp = yf.download("^GSPC", start=start, end=end)
sp = sp[["Close"]].copy()
sp.reset_index(inplace=True)
sp.columns = ["Date", "Close"]
sp['Date'] = pd.to_datetime(sp['Date'])
sp.set_index('Date', inplace=True)
sp_month = sp['Close'].resample("ME").last()
sp_mret = np.log(sp_month).diff().dropna().rename("SP_mlogret")

# -----------------------------
# FRED API setup
# -----------------------------
fred_api_key = 'c06648686b78cc1ee3514cd3fee59e29'  # replace with your own
fred = Fred(api_key=fred_api_key)

# -----------------------------
# Macro series (12 indicators)
# -----------------------------
fred_series = {
    "FEDFUNDS": "Federal Funds Rate",
    "GS10": "10 Year Treasury Yield",
    "CPIAUCSL": "CPI All Items",
    "UNRATE": "Unemployment Rate",
    "M2SL": "M2 Money Stock",
    "BAMLC0A0CM": "BBB Credit Spread",
    "PCEPI": "PCE Price Index",
    "INDPRO": "Industrial Production Index",
    "PAYEMS": "Total Nonfarm Payrolls",
    "HOUST": "Housing Starts",
    "TB3MS": "3-Month Treasury Bill Rate",
    "CPILFESL": "Core CPI"
}

# Download macro data from FRED
macros = {}
for series_id, name in fred_series.items():
    df_macro = fred.get_series(series_id, observation_start=start, observation_end=end)
    df_macro = df_macro.to_frame(name=name)
    macros[name] = df_macro

macro = pd.concat(macros.values(), axis=1)
macro = macro.resample("ME").last()

# -----------------------------
# Transform macro data
# -----------------------------
macro["CPI YoY"] = macro["CPI All Items"].pct_change(12, fill_method=None)
macro["M2 YoY"] = macro["M2 Money Stock"].pct_change(12, fill_method=None)
macro["FEDFUNDS_change"] = macro["Federal Funds Rate"].diff()

# Keep a subset of transformed indicators plus others
macro_m = macro[[
    "CPI YoY",
    "M2 YoY",
    "Unemployment Rate",
    "Federal Funds Rate",
    "BBB Credit Spread",
    "PCE Price Index",
    "Industrial Production Index",
    "Total Nonfarm Payrolls",
    "Housing Starts",
    "10 Year Treasury Yield",
    "3-Month Treasury Bill Rate",
    "Core CPI"
]].dropna()

# -----------------------------
# Shiller CAPE (Shiller P/E) from multpl
# -----------------------------
# Fetch monthly Shiller P/E table and join into macro_m so it becomes
# an additional feature for correlation and regression.
try:
    url = "https://www.multpl.com/shiller-pe/table/by-month"
    resp = requests.get(url, headers={"User-Agent": "python-requests/2.0"}, timeout=20)
    resp.raise_for_status()
    tables = pd.read_html(StringIO(resp.text))
    # The first table contains Date and P/E value by-month
    shiller_tbl = tables[0].copy()
    # Normalize column names in case site changes formatting
    shiller_tbl.columns = [c.strip() for c in shiller_tbl.columns[:2]]
    shiller_tbl = shiller_tbl.iloc[:, :2]
    shiller_tbl.columns = ["Date", "Shiller_PE"]
    shiller_tbl["Date"] = pd.to_datetime(shiller_tbl["Date"])
    shiller_tbl.set_index("Date", inplace=True)
    shiller_ser = pd.to_numeric(shiller_tbl["Shiller_PE"], errors="coerce")
    # Ensure monthly index and take last observation each month
    shiller_ser = shiller_ser.resample("ME").last()
    shiller_ser.name = "Shiller_PE"
    # Join into macro_m (will align on monthly index)
    macro_m = macro_m.join(shiller_ser)
    # Drop rows with any NaNs introduced by the join to keep clean training data
    macro_m = macro_m.dropna()
    print(f"Shiller PE loaded: {len(shiller_ser.dropna())} monthly observations; joined into macro_m.")
except Exception as e:
    print("Warning: could not fetch or parse Shiller PE from multpl:", e)
    print("Continuing without Shiller_PE feature.")

# -----------------------------
# Align S&P 500 and macro
# -----------------------------
df = pd.concat([sp_mret, macro_m], axis=1).dropna()

# -----------------------------
# Correlation with S&P 500
# -----------------------------
corr_signed = df.corr().loc["SP_mlogret"]
corr_abs_sorted = corr_signed.abs().sort_values(ascending=False)
print("Absolute correlations with S&P 500 monthly returns:")
print(corr_abs_sorted)

# -----------------------------
# Latest macro values
# -----------------------------
latest_macro = macro_m.iloc[-1]

# -----------------------------
# Simple correlation-weighted score
# -----------------------------
score = sum((latest_macro[col] - macro_m[col].mean()) * corr_signed[col] for col in macro_m.columns)
print(f"Correlation-weighted score: {score:.4f}")

if score > 0:
    print("Signal: S&P 500 likely UP next month")
else:
    print("Signal: S&P 500 likely DOWN next month")

# -----------------------------
# Optional: Linear regression prediction
# -----------------------------
X = macro_m.values
y = sp_mret.loc[macro_m.index].values
model = LinearRegression().fit(X, y)
pred_next_month = model.predict(latest_macro.values.reshape(1, -1))[0]
print(f"Linear regression predicted next-month log return: {pred_next_month:.4%}")

if pred_next_month > 0:
    print("Regression signal: S&P 500 likely UP next month")
else:
    print("Regression signal: S&P 500 likely DOWN next month")

